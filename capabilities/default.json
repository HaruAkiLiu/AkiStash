{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "AkiStash 主窗口需要的权限：弹出保存对话框，并把文件写到用户选择的位置",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$DESKTOP/**" },
        { "path": "$DOCUMENT/**" },
        { "path": "$DOWNLOAD/**" },
        { "path": "$PICTURE/**" }
      ]
    }
  ]
}
